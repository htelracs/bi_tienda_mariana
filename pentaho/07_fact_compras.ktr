  <step>
    <name>Corregir valores</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>precio_ok</field_name>
      <formula_string>(cantidad.doubleValue() > 0 &amp;&amp; Math.abs(cantidad.doubleValue()*precio_unitario.doubleValue() - descuento.doubleValue() - subtotal_linea.doubleValue()) > 0.05) ? new Double((subtotal_linea.doubleValue() + descuento.doubleValue()) / cantidad.doubleValue()) : precio_unitario</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>tarifa_iva</field_name>
      <formula_string>(tarifa_iva_pct.doubleValue() > 0 &amp;&amp; tarifa_iva_pct.doubleValue() &lt; 1) ? new Double(tarifa_iva_pct.doubleValue() * 100) : tarifa_iva_pct</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>es_bonificacion</field_name>
      <formula_string>subtotal_linea.doubleValue() == 0 ? "S" : "N"</formula_string>
      <value_type>String</value_type>
      <value_length>1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
